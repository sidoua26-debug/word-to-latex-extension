{
  "manifest_version": 3,
  "name": "Word to LaTeX (Offline)",
  "version": "1.0.1",
  "description": "Convert Word documents, pasted rich text, and tables to clean LaTeX fragments entirely offline via Pandoc WASM.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Word to LaTeX",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": ["wasm/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
